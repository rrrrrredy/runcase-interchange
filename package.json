{
  "name": "@runcase/interchange",
  "version": "0.1.2",
  "description": "Versioned JSON Schemas and a validation CLI for portable agent runs, workflow cases, and scores.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Song Luo",
  "repository": {
    "type": "git",
    "url": "https://github.com/rrrrrredy/runcase-interchange.git"
  },
  "bugs": "https://github.com/rrrrrredy/runcase-interchange/issues",
  "homepage": "https://github.com/rrrrrredy/runcase-interchange#readme",
  "bin": {
    "rci": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist/src",
    "schemas",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "npm run build && npm test && npm run validate:examples",
    "test": "node --test dist/test/protocol.test.js",
    "validate:examples": "node dist/src/cli.js validate examples",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.8.3"
  }
}
