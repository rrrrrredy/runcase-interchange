{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runcase-interchange:schema:agent.run.v1",
  "title": "Agent Run v1",
  "description": "A portable record of one agent execution and the evidence retained about it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "goal",
    "agent",
    "configuration",
    "started_at",
    "status",
    "capture",
    "events",
    "artifacts",
    "outcome",
    "user_corrections"
  ],
  "properties": {
    "schema_version": { "const": "agent.run.v1" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "case_id": { "$ref": "#/$defs/uuid" },
    "parent_run_id": { "$ref": "#/$defs/uuid" },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["user", "case", "system", "imported"] },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "product_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_provider": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "files"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": { "$ref": "#/$defs/relative_path" },
              "digest": { "$ref": "#/$defs/sha256" },
              "kind": { "type": "string", "enum": ["agents", "skill", "hook", "mcp", "model", "other"] },
              "content_ref": { "$ref": "#/$defs/content_ref" }
            }
          }
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "environment": { "type": "object", "additionalProperties": true }
      }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled", "agent_timeout", "agent_crash", "infrastructure_error"]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sources", "completeness", "gaps", "redaction"],
      "properties": {
        "mode": { "type": "string", "enum": ["observed", "managed", "imported"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["available", "partial", "unavailable"] },
              "details": { "type": "string" }
            }
          }
        },
        "completeness": { "type": "string", "enum": ["complete", "partial", "unknown"] },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gap_id", "kind", "summary"],
            "properties": {
              "gap_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["missing", "out_of_order", "source_unavailable", "excluded", "redacted", "mapping_loss", "unknown"] },
              "summary": { "type": "string", "minLength": 1 },
              "start_at": { "$ref": "#/$defs/timestamp" },
              "end_at": { "$ref": "#/$defs/timestamp" },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "secret_patterns_applied", "excluded_paths"],
          "properties": {
            "status": { "type": "string", "enum": ["not_needed", "applied", "partial", "unknown"] },
            "secret_patterns_applied": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "excluded_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "redacted_field_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "timestamp", "received_at", "type", "source", "summary", "data", "content_refs", "redacted"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "timestamp": { "$ref": "#/$defs/timestamp" },
          "received_at": { "$ref": "#/$defs/timestamp" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "source": { "type": "string", "minLength": 1 },
          "parent_event_id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "data": { "type": "object", "additionalProperties": true },
          "content_refs": { "type": "array", "items": { "$ref": "#/$defs/content_ref" }, "uniqueItems": true },
          "redacted": { "type": "boolean" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "name", "digest"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["file", "patch", "command_output", "test_result", "report", "screenshot", "other"] },
          "name": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/sha256" },
          "media_type": { "type": "string", "minLength": 1 },
          "content_ref": { "$ref": "#/$defs/content_ref" },
          "path": { "$ref": "#/$defs/relative_path" },
          "produced_by_event_id": { "type": "string", "minLength": 1 },
          "redacted": { "type": "boolean" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "verifier_refs"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "partial", "failure", "unknown"] },
        "summary": { "type": "string" },
        "verifier_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "user_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correction_id", "created_at", "kind", "text", "redacted"],
        "properties": {
          "correction_id": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "kind": { "type": "string", "enum": ["result_label", "instruction", "replacement", "rollback", "other"] },
          "text": { "type": "string", "minLength": 1 },
          "target_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "redacted": { "type": "boolean" }
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "monetary_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": ["succeeded", "failed", "cancelled", "agent_timeout", "agent_crash", "infrastructure_error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "required": ["ended_at"],
        "properties": { "ended_at": { "$ref": "#/$defs/timestamp" } }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "capture": {
            "type": "object",
            "properties": { "completeness": { "const": "complete" } },
            "required": ["completeness"]
          }
        },
        "required": ["capture"]
      },
      "then": {
        "type": "object",
        "properties": {
          "capture": {
            "type": "object",
            "properties": { "gaps": { "type": "array", "maxItems": 0 } }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "capture": {
            "type": "object",
            "properties": { "completeness": { "const": "partial" } },
            "required": ["completeness"]
          }
        },
        "required": ["capture"]
      },
      "then": {
        "type": "object",
        "properties": {
          "capture": {
            "type": "object",
            "properties": { "gaps": { "type": "array", "minItems": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/])" } },
        { "not": { "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)" } }
      ]
    },
    "content_ref": { "type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|urn:[A-Za-z0-9][A-Za-z0-9:._/-]*)$" }
  }
}
